# ========================================================
# Trading Cloudi — Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file containing real secrets to Git.
# ========================================================

# ---- Mode Configuration ----
# Set to 'true' for Binance Demo Futures, 'false' for Production Live
USE_DEMO=true
TRADER_DRY_MODE=false

# ---- Binance Futures API & WebSocket Endpoints ----
# Defaults:
# Demo REST: https://demo-fapi.binance.com
# Demo WS:   wss://demo-fstream.binance.com
# Live REST: https://fapi.binance.com
# Live WS:   wss://fstream.binance.com
BINANCE_FAPI_BASE=https://demo-fapi.binance.com
BINANCE_WS_BASE=wss://demo-fstream.binance.com

# ---- Binance Authentication Keys ----
# For Demo Trading (required for trade execution):
DEMO_API_KEY=your_binance_demo_api_key_here
DEMO_API_SECRET=your_binance_demo_api_secret_here

# For Live Trading (optional, only when USE_DEMO=false):
# BINANCE_API_KEY=your_binance_live_api_key_here
# BINANCE_API_SECRET=your_binance_live_api_secret_here

# ---- Google Gemini AI Engine ----
# Required for Autonomous AI price action evaluation (Workflow 2)
GEMINI_API_KEY=your_google_gemini_api_key_here

# ---- Telegram Alerts & Reports ----
# Required for instant trade execution, watchdog alerts, and hourly reports
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---- Cloud Database (Neon Serverless PostgreSQL) ----
# Required for persistent cloud storage of positions and journal entries across restarts.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-square-lake-azznmcx3-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- Web Dashboard Security (Optional) ----
# Set a secret token to protect Web Dashboard access (via ?token=... or header X-API-KEY)
# DASHBOARD_TOKEN=your_secret_dashboard_token_here
PORT=8000
